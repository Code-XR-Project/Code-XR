  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node ../../node_modules/webpack/bin/webpack.js",
    "compile:dev-host": "npm run compile && node scripts/prepare-dev-extension.mjs",
    "watch": "node ../../node_modules/webpack/bin/webpack.js --watch",
    "package": "node ../../node_modules/webpack/bin/webpack.js --mode production",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit --incremental false -p tsconfig.check.json && node ../../node_modules/typescript/bin/tsc --incremental false -p tsconfig.tooling.json",
    "compile-tests": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && node ../../node_modules/typescript/bin/tsc -p . --outDir out",
    "watch-tests": "node ../../node_modules/typescript/bin/tsc -p . -w --outDir out",
    "lint": "node ../../node_modules/eslint/bin/eslint.js src test scripts templates webpack.config.js eslint.config.mjs --max-warnings 151",
    "test": "npm run test:basic",
    "test:basic": "npm run typecheck && npm run lint && npm run compile-tests && npm run test:unit",
    "test:unit": "node test/runners/run-node-tests.cjs",
    "test:python": "node ../../backend/scripts/run-python-tests.cjs",
    "test:all": "npm run test:basic && npm run test:python",
    "package:vsix": "npm run package && node scripts/package-vsix.mjs",
    "test:analysis": "node ../../backend/scripts/run-analysis-tests.cjs",
    "test:htmlanalysis": "node test/runners/run-html-analysis-tests.cjs",
    "test:core-smoke": "node test/runners/run-core-smoke.cjs",
    "test:xr-harness": "node test/runners/run-xr-containment-harness.cjs",
    "test:xr-chart-bounds-harness": "npm run compile-tests && node test/runners/run-xr-chart-bounds-harness.cjs",
    "test:xr-mode-harness": "node test/runners/run-xr-mode-cycle-harness.cjs",
    "test:xr-immersive-harness": "node test/runners/run-xr-immersive-harness.cjs",
    "test:project-evolution-harness": "node test/runners/run-project-evolution-harness.cjs",
    "test:xr-panel-placement-harness": "node test/runners/run-xr-panel-placement-harness.cjs",
    "test:harnesses": "npm run test:xr-harness && npm run test:xr-chart-bounds-harness && npm run test:xr-mode-harness && npm run test:xr-immersive-harness && npm run test:project-evolution-harness && npm run test:xr-panel-placement-harness",
    "report:manual-metrics": "node ../../backend/scripts/run-analysis-tests.cjs --report-only",
    "guardrails:measure": "node test/tooling/measureGuardrails.cjs",
    "guardrails:update": "node test/tooling/measureGuardrails.cjs --write",
    "python:requirements": "npm run compile-tests && node test/tooling/pythonRequirements.cjs --write"
  },
