{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"outDir": "out",

		"lib": [
			"ES2022",
			"DOM"
		],
		"types": ["node", "vscode"],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,   /* enable all strict type-checking options */
		"esModuleInterop": true,
		"moduleResolution": "Node16",
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
		/* Additional Checks */
		// "noUnusedParameters": true,  /* Report errors on unused parameters. */
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		"out"
	]
}
