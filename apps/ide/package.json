{
  "name": "code-xr-ide",
  "private": true,
  "version": "0.1.0",
  "description": "Code-XR IDE: a desktop environment (Electron + Monaco) to edit, analyse and explore code in XR.",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node scripts/start.mjs",
    "smoke": "node scripts/build.mjs && node scripts/smoke.mjs",
    "dist": "npm run compile --workspace=code-xr && node scripts/build.mjs && node ../../node_modules/electron-builder/cli.js --config electron-builder.config.cjs --publish never",
    "typecheck": "node scripts/coreTypes.mjs && node ../../node_modules/typescript/bin/tsc -p tsconfig.node.json && node ../../node_modules/typescript/bin/tsc -p tsconfig.web.json",
    "lint": "node ../../node_modules/eslint/bin/eslint.js src test scripts eslint.config.mjs --max-warnings 0",
    "test:unit": "node --import ./scripts/testCoreAlias.mjs --test --experimental-strip-types \"test/**/*.test.ts\"",
    "test": "npm run typecheck && npm run lint && npm run test:unit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/vscode": "1.146.0",
    "@types/yauzl": "3.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.15",
    "electron": "^45.5.0",
    "electron-builder": "26.18.1",
    "jsonc-parser": "3.3.1",
    "marked": "14.0.0",
    "material-icon-theme": "^5.40.0",
    "monaco-editor": "0.57.0",
    "vite": "^8.3.8",
    "vscode-jsonrpc": "9.0.3",
    "vscode-languageserver-types": "3.18.4",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "vscode-uri": "3.2.0",
    "yauzl": "3.4.0"
  },
  "dependencies": {
    "node-pty": "1.2.0-beta.18",
    "typescript": "5.8.3",
    "typescript-language-server": "6.1.0"
  },
  "author": "Adrián Montes Linares",
  "homepage": "https://github.com/Code-XR-Project/Code-XR"
}
