{
  "name": "code-xr-monorepo",
  "private": true,
  "description": "Code-XR monorepo: the VS Code extension, the Python analysis backend and the Code-XR IDE (Electron + Monaco).",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "compile": "npm run compile --workspace=code-xr",
    "compile:dev-host": "npm run compile:dev-host --workspace=code-xr",
    "watch": "npm run watch --workspace=code-xr",
    "package": "npm run package --workspace=code-xr",
    "typecheck": "npm run typecheck --workspace=code-xr",
    "compile-tests": "npm run compile-tests --workspace=code-xr",
    "watch-tests": "npm run watch-tests --workspace=code-xr",
    "lint": "npm run lint --workspace=code-xr",
    "test": "npm run test --workspace=code-xr && npm run test --workspace=code-xr-ide",
    "test:basic": "npm run test:basic --workspace=code-xr",
    "test:unit": "npm run test:unit --workspace=code-xr",
    "test:python": "npm run test:python --workspace=code-xr",
    "test:all": "npm run test:all --workspace=code-xr",
    "package:vsix": "npm run package:vsix --workspace=code-xr",
    "test:analysis": "npm run test:analysis --workspace=code-xr",
    "test:htmlanalysis": "npm run test:htmlanalysis --workspace=code-xr",
    "test:core-smoke": "npm run test:core-smoke --workspace=code-xr",
    "test:xr-harness": "npm run test:xr-harness --workspace=code-xr",
    "test:xr-chart-bounds-harness": "npm run test:xr-chart-bounds-harness --workspace=code-xr",
    "test:xr-mode-harness": "npm run test:xr-mode-harness --workspace=code-xr",
    "test:xr-immersive-harness": "npm run test:xr-immersive-harness --workspace=code-xr",
    "test:project-evolution-harness": "npm run test:project-evolution-harness --workspace=code-xr",
    "test:xr-panel-placement-harness": "npm run test:xr-panel-placement-harness --workspace=code-xr",
    "test:harnesses": "npm run test:harnesses --workspace=code-xr",
    "report:manual-metrics": "npm run report:manual-metrics --workspace=code-xr",
    "guardrails:measure": "npm run guardrails:measure --workspace=code-xr",
    "guardrails:update": "npm run guardrails:update --workspace=code-xr",
    "python:requirements": "npm run python:requirements --workspace=code-xr",
    "test:backend": "node backend/scripts/run-python-tests.cjs",
    "lint:python": "node backend/scripts/run-ruff.cjs",
    "ide:dev": "npm run dev --workspace=code-xr-ide",
    "ide:build": "npm run build --workspace=code-xr-ide",
    "ide:start": "npm run start --workspace=code-xr-ide",
    "ide:smoke": "npm run smoke --workspace=code-xr-ide",
    "ide:test": "npm run test --workspace=code-xr-ide"
  },
  "overrides": {
    "serialize-javascript": "7.0.4"
  }
}
